# Copie para .env.local após `base44 link` (ou use `base44 dev`, que injeta automaticamente).
# Nunca commite segredos.

# ID do app no Base44 (visível na URL do Builder: app.base44.com/apps/<id>)
VITE_BASE44_APP_ID=

# URL base do backend (preenchida pelo CLI em `base44 dev` / `base44 dev --remote`)
VITE_BASE44_APP_BASE_URL=

# Versão das functions (opcional; o CLI normalmente define)
VITE_BASE44_FUNCTIONS_VERSION=
